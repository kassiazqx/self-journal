# Stage 1 E2E runtime env
# Copy to `.env.e2e.local` (or your local secret manager), never commit real values.

# App runtime values used by Vite dev server during Playwright runs.
VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_test_project_anon_key

# Optional local Playwright server overrides.
PLAYWRIGHT_BASE_PORT=4173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173

# Dedicated Supabase test project values for reset / fixture scripts.
E2E_SUPABASE_URL=https://your-test-project.supabase.co
E2E_SUPABASE_ANON_KEY=your_test_project_anon_key
E2E_SUPABASE_SERVICE_ROLE_KEY=your_test_project_service_role_key

# Existing-user account: reusable for save/edit/settings/awareness recovery flows.
E2E_EXISTING_USER_EMAIL=e2e.existing@example.com
E2E_EXISTING_USER_PASSWORD=replace_with_local_secret

# Brand-new bootstrap account: reserved for first-login bootstrap only.
E2E_BOOTSTRAP_USER_EMAIL=e2e.bootstrap@example.com
E2E_BOOTSTRAP_USER_PASSWORD=replace_with_local_secret

# Optional explicit user ids for future reset whitelist scripts.
E2E_EXISTING_USER_ID=00000000-0000-0000-0000-000000000000
E2E_BOOTSTRAP_USER_ID=11111111-1111-1111-1111-111111111111
